{
  "name": "dr-murtadha-academic-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run validate && ASTRO_TELEMETRY_DISABLED=1 astro build && npm run validate:build && npm run check:links && npm run check:budget",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "validate": "node scripts/validate-content.mjs",
    "validate:build": "node scripts/validate-build.mjs dist",
    "check:links": "node scripts/check-links.mjs dist",
    "check:budget": "node scripts/check-performance-budget.mjs dist",
    "check:external": "node scripts/check-external-links.mjs",
    "check:external:site": "node scripts/check-external-links.mjs --scope=site --dir=dist",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "import:pages": "node scripts/import-approved-pages.mjs",
    "audit:wordpress": "node scripts/audit-content.mjs",
    "build:publications": "node scripts/build-publications-data.mjs",
    "build:people": "node scripts/build-people-data.mjs",
    "build:publication-collections": "node scripts/build-publication-collections.mjs",
    "build:teaching": "node scripts/build-teaching-data.mjs",
    "build:data": "npm run build:publications && npm run build:publication-collections && npm run build:people && npm run build:teaching"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2",
    "node-html-parser": "^7.0.1"
  }
}
