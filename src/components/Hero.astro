---
import AnimationSlot from './AnimationSlot.astro';
import NetworkHeroMotion from './NetworkHeroMotion.astro';
---
<section class="home-hero" aria-labelledby="hero-title">
  <div class="home-hero__copy">
    <p class="eyebrow">Murtadha / Networked Intelligence</p>
    <h1 id="hero-title">Intelligence is not isolated. It is <em>connected.</em></h1>
    <p class="lede">Research across networked sensing, resilient systems, autonomous movement and the people who make knowledge travel.</p>
    <div class="actions">
      <a class="button" href="/research/">Explore the research</a>
      <a class="text-link" href="/publications/">Publication record <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <AnimationSlot name="hero-network" label="Reserved boundary for the future Networked Intelligence motion layer">
    <figure class="hero-portrait">
      <img src="/assets/images/murtadha-office-desk.jpg" alt="Mohd Murtadha working at his academic office desk" width="1448" height="1086" fetchpriority="high" />
      <figcaption><span>01</span> Faculty of Computing · UTM</figcaption>
      <NetworkHeroMotion />
    </figure>
  </AnimationSlot>
</section>
