---
import AnimationSlot from './AnimationSlot.astro';
---
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Murtadha / Networked Intelligence</p>
    <h1>Researching intelligence across connected systems.</h1>
    <p class="lede">Wireless networks, resilient sensing, software-defined systems and human-centred academic collaboration.</p>
    <div class="actions"><a class="button" href="/research/">Explore research</a><a href="/publications/">View publications</a></div>
  </div>
  <AnimationSlot name="hero-network" label="Reserved interactive network visualisation">
    <div class="network-placeholder" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
  </AnimationSlot>
</section>
