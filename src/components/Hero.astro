---
import AnimationSlot from './AnimationSlot.astro';
import NetworkHeroMotion from './NetworkHeroMotion.astro';
---
<section class="home-hero" aria-labelledby="hero-title">
  <div class="home-hero__copy">
    <p class="eyebrow">Associate Professor · Faculty of Computing, UTM</p>
    <h1 id="hero-title">Research for a connected world.</h1>
    <p class="hero-name">Mohd Murtadha Bin Mohamad</p>
    <p class="lede">Artificial intelligence, wireless sensor networks and autonomous systems. Connecting environmental sensing with informed decisions for people and places.</p>
    <div class="actions">
      <a class="button" href="/research/">Explore the research</a>
      <a class="button button--secondary" href="/connect/">Discuss a collaboration</a>
    </div>
  </div>
  <AnimationSlot name="hero-network" label="Academic work and connected research themes">
    <figure class="hero-portrait">
      <img src="/assets/images/murtadha-office-desk.jpg" alt="Mohd Murtadha working at his academic office desk" width="1448" height="1086" fetchpriority="high" />
      <figcaption><span>Universiti Teknologi Malaysia</span> Research &amp; education</figcaption>
      <NetworkHeroMotion />
    </figure>
  </AnimationSlot>
</section>
