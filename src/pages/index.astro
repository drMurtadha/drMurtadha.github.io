---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ResearchConstellation from '../components/ResearchConstellation.astro';
import profile from '../data/academic-profile.json';
---
<BaseLayout title="Networked Intelligence" description="Mohd Murtadha Mohamad researches networked sensing, resilient systems, autonomous movement and postgraduate education at Universiti Teknologi Malaysia.">
  <Hero />

  <section class="metrics" aria-label="Verified Scopus profile metrics">
    <a href={`https://www.scopus.com/authid/detail.uri?authorId=${profile.scopusAuthorId}`} rel="noopener noreferrer">
      <span class="metrics__source">Scopus profile · verified September 2026</span>
      <span class="metric"><strong>{profile.metrics.scopus.documents}</strong> documents</span>
      <span class="metric"><strong>{profile.metrics.scopus.citations}</strong> citations</span>
      <span class="metric"><strong>{profile.metrics.scopus.hIndex}</strong> h-index</span>
      <span class="metrics__arrow" aria-hidden="true">↗</span>
    </a>
  </section>

  <ResearchConstellation />

  <section class="selected section" aria-labelledby="selected-title">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">02 / Work in context</p>
        <h2 id="selected-title">Research meets<br /><em>the real world.</em></h2>
      </div>
      <p>From networks below the waterline to quiet environmental changes inside heritage buildings.</p>
    </header>
    <div class="story-grid">
      <article class="story-card story-card--feature">
        <span class="story-card__number">01</span>
        <p class="story-card__tags">IoT · microclimates · explainable AI</p>
        <h3>Heritage intelligence</h3>
        <p>Sensing invisible conditions that slowly affect historic buildings—and turning them into better maintenance decisions.</p>
      </article>
      <article class="story-card story-card--dark">
        <span class="story-card__number">02</span>
        <p class="story-card__tags">UWASN · routing · AUV</p>
        <h3>Networks underwater</h3>
        <p>Designing communication and autonomous navigation for environments where ordinary radio cannot reach.</p>
      </article>
      <article class="story-card story-card--accent">
        <span class="story-card__number">03</span>
        <p class="story-card__tags">MANET · trust · federated learning</p>
        <h3>Networks without infrastructure</h3>
        <p>Building security and trust into distributed systems that keep moving.</p>
      </article>
    </div>
  </section>

  <section class="people-feature">
    <div class="people-feature__image">
      <img src="/assets/images/murtadha-supervision-meeting.jpg" alt="Mohd Murtadha discussing research with two doctoral candidates" width="1448" height="1086" loading="lazy" />
    </div>
    <div class="people-feature__copy">
      <p class="eyebrow">03 / People and supervision</p>
      <h2>Research grows<br /><em>through people.</em></h2>
      <p>Postgraduate supervision connects questions across network security, IoT intrusion detection, underwater sensing, positioning and autonomous systems.</p>
      <a class="text-link" href="/people/">Meet the researchers <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="institution-layer section" aria-labelledby="ascend-title">
    <p class="eyebrow">UTM ASCEND 2030 · Institutional layer</p>
    <div>
      <h2 id="ascend-title">Knowledge that moves<br />from inquiry to impact.</h2>
      <p>Academic work grounded at Universiti Teknologi Malaysia: developing talent, strengthening research networks and translating computing expertise into meaningful partnerships.</p>
      <a class="text-link" href="/impact/">Explore impact and engagement <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-cta section">
    <p class="eyebrow">The next connection</p>
    <h2>Let’s ask a<br /><em>better question.</em></h2>
    <a href={`mailto:${profile.email}?subject=Research%20collaboration`}>{profile.email} <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
