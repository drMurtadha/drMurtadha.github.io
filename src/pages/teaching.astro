---
import BaseLayout from '../layouts/BaseLayout.astro';
import teaching from '../data/teaching.json';
---
<BaseLayout title="Teaching" description="Undergraduate and postgraduate teaching record of Mohd Murtadha Mohamad at the Faculty of Computing, UTM.">
  <header class="page-hero"><div><p class="eyebrow">Teaching / Knowledge in practice</p><h1>From logic gates to <em>networked systems.</em></h1><p>Eight undergraduate subjects across twenty-eight semester entries, alongside four postgraduate subjects and research supervision.</p></div><dl class="page-metrics"><div><dt>Undergraduate subjects</dt><dd>{teaching.summary.undergraduateSubjects}</dd></div><div><dt>Semester entries</dt><dd>{teaching.summary.undergraduateSemesterEntries}</dd></div><div><dt>Students since 2006</dt><dd>{teaching.summary.undergraduateStudents}</dd></div><div><dt>Postgraduate subjects</dt><dd>{teaching.summary.postgraduateSubjects}</dd></div></dl></header>
  <div class="page-body teaching-page"><section class="teaching-intro"><p class="eyebrow">01 / Teaching record</p><h2>Courses taught across two decades.</h2><p>Open a subject to view its recorded academic sessions. Ongoing classes are retained as such; the figures are not inferred.</p></section><div class="subject-list">{teaching.subjects.map((subject, index) => <details open={index === 0}><summary><span>{String(index + 1).padStart(2, '0')}</span><h2>{subject.title}</h2><strong>{subject.entries.length} entries</strong></summary><div class="subject-table" role="region" aria-label={`${subject.title} teaching history`} tabindex="0"><table><thead><tr>{Object.keys(subject.entries[0] || {}).map((heading) => <th>{heading}</th>)}</tr></thead><tbody>{subject.entries.map((entry) => <tr>{Object.values(entry).map((value) => <td>{value}</td>)}</tr>)}</tbody></table></div></details>)}</div><section class="research-cta"><p class="eyebrow">Questions and supervision</p><h2>Learning begins with a better question.</h2><a class="button" href="mailto:murtadha@utm.my?subject=Teaching%20or%20research%20inquiry">Start a conversation</a></section></div>
</BaseLayout>
