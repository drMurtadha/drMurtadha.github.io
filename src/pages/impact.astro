---
import BaseLayout from '../layouts/BaseLayout.astro';
const streams = [
  { index: '01', title: 'National information systems', total: 'RM2.64m', intro: 'MACA Integrated Information Management System—consultation leadership from 2020 to 2024.', items: [['MACA Integrated Information Management System (SPMB)', 'RM2,639,400.00']] },
  { index: '02', title: 'Digital government and enterprise systems', total: 'RM1.92m', intro: 'Feasibility studies, requirement studies and maintenance programmes for public-sector systems.', items: [['Higher-education data warehouse feasibility','RM498,937.07'],['MyMRSM information-management feasibility','RM198,552.84'],['BKOKU system study','RM400,000.00'],['E-IPTS maintenance programme (combined)','RM749,840.00'],['Google Workspace licensing','RM69,800.00']] },
  { index: '03', title: 'Blockchain capability and training', total: 'RM408k', intro: 'Capability development for industry teams, SMEs and certified professionals.', items: [['Industry training and SME services','RM108,000.00'],['Professional certification training','RM199,672.20'],['Blockchain subject-matter expert engagement','RM100,000.00']] }
];
---
<BaseLayout title="Consultancy and industry engagement" description="Selected consultancy, digital-government, enterprise-systems and professional-capability engagements by Mohd Murtadha Mohamad.">
  <header class="page-hero"><div><p class="eyebrow">Impact / Beyond campus</p><h1>Knowledge moves into <em>practice.</em></h1><p>Selected engagements translating computing expertise into government systems, institutional infrastructure and professional capability development.</p></div><p class="page-hero__statement">Three recorded streams spanning national systems, digital government and professional capability.</p></header>
  <div class="page-body impact-page"><section class="impact-capabilities"><article><span>01</span><h2>Feasibility and requirements</h2><p>User-requirement studies and feasibility assessments for information-management and enterprise systems.</p></article><article><span>02</span><h2>Technical advisory</h2><p>Subject-matter expertise across networks, security architecture and distributed-ledger technology.</p></article><article><span>03</span><h2>Capability development</h2><p>Professional certification programmes and applied training for industry teams and SMEs.</p></article></section><section class="impact-streams">{streams.map((stream) => <article><header><span>{stream.index}</span><div><h2>{stream.title}</h2><p>{stream.intro}</p></div><strong>{stream.total}</strong></header><table><thead><tr><th>Engagement</th><th>Recorded value</th></tr></thead><tbody>{stream.items.map((item) => <tr><td>{item[0]}</td><td>{item[1]}</td></tr>)}</tbody></table></article>)}</section><section class="research-cta"><p class="eyebrow">Consultancy and collaboration</p><h2>Have a system that needs this kind of work?</h2><a class="button" href="mailto:murtadha@utm.my?subject=Consultancy%20or%20industry%20engagement">Discuss an engagement</a></section></div>
</BaseLayout>
